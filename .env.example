APP_NAME="Ruang Warga Sa'ar Kleco"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-project.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Gunakan PostgreSQL persisten dari penyedia database Anda.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Jangan memakai password biasa. Isi dengan hasil password_hash(...).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_CACHE_SECONDS=300
GOOGLE_DRIVE_CA_BUNDLE=
